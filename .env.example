# ---- Trading Desk -------------------------------------------------------------
# Login: the owner account is created with `python -m desk.cli create-user <name>`
# (docs/security.md). Sessions end this long after sign-in / after the last request.
DESK_SESSION_MAX_HOURS=72
DESK_SESSION_IDLE_HOURS=12
# Keep true. Browsers accept Secure cookies on http://localhost, so dev works too.
# (The server compose pins both of these; they only matter for local runs.)
DESK_COOKIE_SECURE=true
# FastAPI /docs (behind the login).
DESK_ENABLE_DOCS=false
# Fernet key that seals TOTP secrets (docs/security.md §6). Make one with
# `python -m desk.cli otp-key`. Empty = OTP cannot be turned on. Losing it locks out
# an OTP account until `python -m desk.cli disable-otp <email>`.
DESK_OTP_KEY=
# Local: sqlite. Server: the homelab PostgreSQL, schema "desk" (never public):
# postgresql+psycopg://trading_desk:<password>@192.168.0.11:5432/trading_desk?options=-csearch_path%3Ddesk
DESK_DATABASE_URL=sqlite:///data/desk.db
# Default investing style handed to the trader / risk debate / portfolio manager:
# aggressive_leverage (2-3x leveraged or inverse, days to weeks) | balanced
DESK_INVESTOR_PROFILE=aggressive_leverage
# true = scripted debate, no LLM calls (UI work without spending quota)
DESK_FAKE_RUNS=false
DESK_MAX_CONCURRENT_RUNS=1
# Finished runs older than this many days are deleted (at start, then daily). 0 = keep all.
DESK_RETENTION_DAYS=90
# Seconds between passes scoring finished plans against later bars (target/stop first). 0 = off.
DESK_SCORE_INTERVAL_SEC=3600
# 세계 뉴스 흐름(GDELT, 무키) 테마를 다시 모으는 간격(초). 0 = 끔 (#115)
DESK_MACRO_INTERVAL_SEC=1800
# mock | toss
DESK_BROKER=mock
# Seconds between portfolio snapshots on the live panel stream (2..60)
DESK_PORTFOLIO_STREAM_SEC=5

# ---- Server only (docker compose, docs/deploy.md) ---------------------------------
# External docker network shared by the backend and web containers.
DESK_DOCKER_NETWORK=trading-desk-prod
# Web container port on the host: bind to the private IP the ingress (192.168.0.12) reaches.
DESK_WEB_BIND=192.168.0.9
DESK_WEB_PORT=10088
DESK_BACKEND_MEM_LIMIT=2g
DESK_WEB_MEM_LIMIT=128m
# Log timestamps only; stored times are always UTC.
TIME_ZONE=Asia/Seoul

# ---- Toss Securities Open API (read-only: holdings) ------------------------------
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Empty = first BROKERAGE account
TOSS_ACCOUNT_SEQ=
# ---- KIS (Korea Investment) Open API: real-time trades over websocket (#125) ----
# Empty = off (the live page keeps polling Toss). Quote-only use; values only in the server env.
DESK_KIS_APP_KEY=
DESK_KIS_APP_SECRET=
# Empty = real trading. Mock-trading keys: ws://ops.koreainvestment.com:31000/tryitout and
# https://openapivts.koreainvestment.com:29443
DESK_KIS_WS_URL=
DESK_KIS_REST_URL=
# KR codes listed on KOSDAQ (Yahoo .KQ); everything else KR maps to .KS
DESK_KOSDAQ_SYMBOLS=

# ---- semibot (regime / trigger panel) --------------------------------------------
# Local dev only: absolute path to semibot.db (semibot runs on the PC, not the server).
SEMIBOT_DB_PATH=

# ---- TradingAgents (read by the library itself) -----------------------------------
# ChatGPT Plus/Pro plan: no key, sign in once (see README).
TRADINGAGENTS_LLM_PROVIDER=chatgpt
# Model IDs your plan lists after sign-in.
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_OUTPUT_LANGUAGE=Korean
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
# Speed (#171), off until compared (fork branch feat/parallel-openings): round one's speakers open
# at the same time instead of rebutting each other, and each model tier may get its own reasoning effort.
TRADINGAGENTS_DEBATE_PARALLEL_FIRST_ROUND=
TRADINGAGENTS_RISK_PARALLEL_FIRST_ROUND=
TRADINGAGENTS_QUICK_THINK_REASONING_EFFORT=
TRADINGAGENTS_DEEP_THINK_REASONING_EFFORT=
TRADINGAGENTS_NO_UPDATE_CHECK=1
# SEC asks for a contact address
SEC_EDGAR_USER_AGENT=
# Optional data keys
FRED_API_KEY=
# Fallback: local Ollama (slow on CPU)
# TRADINGAGENTS_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://192.168.0.10:11434/v1
