# ---- Trading Desk -------------------------------------------------------------
# Shared secret for the API. Set it unless the site sits behind an authenticating
# proxy or VPN: whoever reaches the API spends your ChatGPT plan and sees your book.
DESK_API_TOKEN=
# true = scripted debate, no LLM calls (UI work without spending quota)
DESK_FAKE_RUNS=false
DESK_MAX_CONCURRENT_RUNS=1
# mock | toss
DESK_BROKER=mock
DESK_WEB_PORT=8088

# ---- Toss Securities Open API (read-only: holdings) ------------------------------
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Empty = first BROKERAGE account
TOSS_ACCOUNT_SEQ=
# KR codes listed on KOSDAQ (Yahoo .KQ); everything else KR maps to .KS
DESK_KOSDAQ_SYMBOLS=

# ---- semibot (regime / trigger panel) --------------------------------------------
# Local dev: absolute path to semibot.db. Docker: the folder holding it.
SEMIBOT_DB_PATH=
SEMIBOT_DATA_DIR=

# ---- TradingAgents (read by the library itself) -----------------------------------
# ChatGPT Plus/Pro plan: no key, sign in once (see README).
TRADINGAGENTS_LLM_PROVIDER=chatgpt
# Model IDs your plan lists after sign-in.
TRADINGAGENTS_QUICK_THINK_LLM=
TRADINGAGENTS_DEEP_THINK_LLM=
TRADINGAGENTS_OUTPUT_LANGUAGE=Korean
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_NO_UPDATE_CHECK=1
# SEC asks for a contact address
SEC_EDGAR_USER_AGENT=
# Optional data keys
FRED_API_KEY=
# Fallback: local Ollama (slow on CPU)
# TRADINGAGENTS_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://192.168.0.10:11434/v1
