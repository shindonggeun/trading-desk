# 웹 컨테이너 nginx (frontend.Dockerfile 이 /etc/nginx/templates 에 두고 기동 시 envsubst 한다).
# 치환되는 것은 컨테이너에 정의된 환경변수(BACKEND_UPSTREAM)뿐이다 — $host 같은 nginx 변수는 그대로 남는다.

# #712 접근 로그는 컨테이너 로그(stdout)로 퍼지므로 클라이언트 IPv4 의 마지막 옥텟을 가린다(그 밖의 주소는 "?").
# 로그인 차단(fail2ban)은 이 로그가 아니라 인그레스 nginx 접근 로그를 본다(Infra nginx-trading-login).
map $remote_addr $desk_masked_addr {
    "~^(?<desk_net>\d+\.\d+\.\d+)\.\d+$" $desk_net.x;
    default                                  "?";
}
log_format desk_masked '$desk_masked_addr - [$time_local] "$request" $status $body_bytes_sent '
                       '"$http_referer" "$http_user_agent" $request_time';
server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;

    # 실제 클라이언트 주소: 홈랩 인그레스(storage 192.168.0.12)가 붙인 X-Real-IP 만 믿는다.
    # 그 밖(LAN 직접 접속 · docker)은 접속한 주소 그대로다 (docs/security.md §4)
    set_real_ip_from 192.168.0.12;
    real_ip_header X-Real-IP;
    access_log /var/log/nginx/access.log desk_masked;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    # #537 압축: JS · CSS · JSON(API 포함) · SVG 만. text/event-stream(SSE 4곳)은 목록에 없어 압축하지 않는다 —
    # 압축은 이벤트를 모았다 내보내 실시간 표시를 늦춘다. 인그레스를 거친 요청도 압축한다(gzip_proxied any).
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript text/javascript application/json application/manifest+json image/svg+xml text/plain;

    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM};
        # $http_host 는 포트를 유지한다 — :10088 직접 접속에서도 API 의 Origin == Host 검사가 맞는다
        proxy_set_header Host $http_host;
        # 덧붙이지 않고 덮어쓴다: 클라이언트가 보낸 X-Forwarded-For 가 uvicorn --proxy-headers 에 닿으면 안 된다
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        # SSE: 버퍼링 없이, 오래 읽는다(분석 한 번이 수 분)
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # Vite 산출물은 파일명에 해시가 있어 오래 캐시해도 된다
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
    }

    # #362 서비스 워커 · 매니페스트는 늘 새로 확인한다 — 배포한 sw.js 가 바로 바뀌게
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        # index.html 은 캐시하지 않는다 — 배포 직후 새 자산 이름을 바로 읽게
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
        try_files $uri /index.html;
    }
}
